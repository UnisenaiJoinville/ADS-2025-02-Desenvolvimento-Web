{
  "name": "estoque-facil",
  "version": "1.0.0",
  "description": "Sistema de gestao de estoque - Node.js, Express, MySQL e Docker",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "css:build": "tailwindcss -i ./styles/app.css -o ./public/css/app.css --minify",
    "css:watch": "tailwindcss -i ./styles/app.css -o ./public/css/app.css --watch",
    "test:reports": "node tests/reports.integration.mjs",
    "test:part9": "node tests/part9.integration.mjs",
    "test:browser": "playwright test",
    "test:lighthouse": "node tests/lighthouse.mjs"
  },
  "engines": {
    "node": ">=20.6.0"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "express": "^4.21.2",
    "express-rate-limit": "8.7.3",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.11.5"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "lighthouse": "13.6.0",
    "tailwindcss": "3.4.17"
  }
}
