{
  "name": "estoque-facil",
  "version": "2.0.0",
  "description": "Sistema de gestao de estoque - Node.js, Express, MySQL e Docker",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "setup": "node scripts/setup.js",
    "css:build": "tailwindcss -i ./styles/input.css -o ./public/css/app.css --minify",
    "css:watch": "tailwindcss -i ./styles/input.css -o ./public/css/app.css --watch",
    "build": "node scripts/build-assets.js && npm run css:build",
    "test": "node --test tests/unit.test.js",
    "test:integration": "node --test --test-concurrency=1 tests/integration.test.js",
    "test:ui": "node tests/ui.mjs",
    "check": "node scripts/check.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "axios": "^1.21.0",
    "bcryptjs": "^3.0.3",
    "chart.js": "^4.6.1",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "lucide": "^0.468.0",
    "mysql2": "^3.11.5",
    "vue": "^3.5.45"
  },
  "devDependencies": {
    "playwright": "1.56.1",
    "prettier": "^3.9.10",
    "tailwindcss": "^3.4.19"
  }
}
