# Imagem de PRODUCAO da API (o Dockerfile da raiz continua sendo o de aula).

# ============================================================
# Etapa 1 - gera o CSS do Tailwind (Aula 69)
# So o arquivo que ela produz e copiado para a etapa 2.
# ============================================================
FROM node:22-alpine AS css

WORKDIR /build

COPY package*.json ./
# Aqui SIM instalamos as devDependencies: o tailwindcss e uma delas.
RUN npm ci

COPY tailwind.config.js ./
COPY styles ./styles
# O Tailwind precisa LER as paginas e os .js para achar as classes.
COPY public ./public

RUN npm run css:build

# ============================================================
# Etapa 2 - a imagem de PRODUCAO da API (Aula 47)
# ============================================================
FROM node:22-alpine

# Faz o Express e as bibliotecas trabalharem em modo producao
ENV NODE_ENV=production

WORKDIR /app

# "npm ci" instala EXATAMENTE o package-lock.json; "--omit=dev" deixa o tailwindcss de fora.
COPY package*.json ./
RUN npm ci --omit=dev && npm cache clean --force

# So o que a aplicacao precisa para rodar: nada de .env, apostilas ou banco
COPY --chown=node:node src ./src
COPY --chown=node:node public ./public
# Da etapa 1, so o CSS pronto.
COPY --chown=node:node --from=css /build/public/css/app.css ./public/css/app.css

# Usuario sem poderes de administrador: se invadirem a aplicacao, nao entram como root.
USER node

EXPOSE 3000

CMD ["node", "src/server.js"]
