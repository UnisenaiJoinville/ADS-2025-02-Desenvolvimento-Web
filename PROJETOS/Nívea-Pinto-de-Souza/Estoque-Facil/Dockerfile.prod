FROM node:22-alpine AS css
WORKDIR /build
COPY package*.json ./
RUN npm ci
COPY tailwind.config.js ./
COPY styles ./styles
COPY public ./public
RUN npm run css:build

FROM node:22-alpine
ENV NODE_ENV=production
WORKDIR /app
COPY package*.json ./
RUN npm ci --omit=dev && npm cache clean --force
COPY src ./src
COPY public ./public
COPY --from=css /build/public/css/app.css ./public/css/app.css
EXPOSE 3000
CMD ["node", "src/server.js"]
