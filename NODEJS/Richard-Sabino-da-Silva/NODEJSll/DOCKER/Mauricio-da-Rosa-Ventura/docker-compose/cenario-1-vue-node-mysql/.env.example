# Copie este arquivo para .env antes de subir a pilha (cp .env.example .env)
# e preencha com valores locais. O .env real NUNCA deve ser commitado.

MYSQL_DATABASE=cenario1
MYSQL_USER=cenario1_user
MYSQL_PASSWORD=troque-esta-senha
MYSQL_ROOT_PASSWORD=troque-esta-senha-root

RABBITMQ_USER=cenario1
RABBITMQ_PASSWORD=troque-esta-senha

# Usada pela API para montar as strings de conexao com mysql/redis/rabbitmq
DB_HOST=mysql
DB_PORT=3306
REDIS_HOST=redis
REDIS_PORT=6379
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
